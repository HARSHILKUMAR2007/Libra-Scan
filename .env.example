# Application
APP_ENV=development
LOG_LEVEL=INFO
BULK_WORKERS=2

# Storage
MAX_UPLOAD_MB=10
UPLOAD_DIR=data/uploads
DATABASE_URL=sqlite:///data/books.db

# OCR & Image Processing
MAX_IMAGE_SIDE=2000
OCR_MIN_CONFIDENCE=0.5
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
